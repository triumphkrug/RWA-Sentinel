# RWA-Sentinel Configuration
# Copy to .env and set values before running

# Casper node connection
NODE_URL=https://node.integration.cspr.cloud/
CHAIN_NAME=casper-test
DEPLOYER_KEY_PATH=./keys/secret_key.pem

# Pipeline parameters
BATCH_SIZE=10
CHALLENGE_RATE_LIMIT=3
NFT_VALIDITY_HOURS=24
STALE_THRESHOLD_MINUTES=30

# Scoring thresholds
TRUST_SCORE_THRESHOLD=65

# Dashboard
DASHBOARD_PORT=3000

# Contract hashes (set after testnet deploy)
ASSET_REGISTRY_HASH=
ATTESTATION_STORE_HASH=
