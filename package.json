{
  "name": "rwa-sentinel",
  "version": "0.2.0",
  "description": "AI-powered real-world asset oracle for Casper Network",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch agent/src/index.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint agent/src --ext .ts",
    "lint:fix": "eslint agent/src --ext .ts --fix",
    "format": "prettier --write 'agent/src/**/*.ts'",
    "format:check": "prettier --check 'agent/src/**/*.ts'",
    "serve": "node dist/server.js"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "prettier": "^3.9.3",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "@types/pg": "^8.11.0"
  },
  "dependencies": {
    "fastify": "^4.26.0",
    "pino": "^9.0.0",
    "zod": "^3.22.0",
    "pg": "^8.12.0"
  }
}